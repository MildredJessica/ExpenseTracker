PORT=3001
NODE_ENV=development

# Clerk
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# CORS
CLIENT_URL=http://localhost:5173

# OCR — optional but recommended for near-perfect merchant/amount extraction.
# If set, /api/scanner/ocr sends the receipt image to a vision LLM first
# and falls back to local Tesseract when unset or on failure.
# OPENAI_API_KEY=sk-...
# OCR_LLM_MODEL=gpt-4o-mini
